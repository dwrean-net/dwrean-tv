<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>dwrean.TV</AssemblyName>
    <RootNamespace>DwreanTv</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>

    <!--
      Bundle all managed .NET assemblies (including LibVLCSharp.dll and
      LibVLCSharp.WinForms.dll) inside dwrean.TV.exe. The native VideoLAN
      files remain next to the app, which is the most reliable layout for
      LibVLC while avoiding a loose LibVLCSharp.dll that Smart App Control
      may block on some Windows 11 systems.
    -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <DebugType>embedded</DebugType>

    <ApplicationIcon>Assets\dwrean.ico</ApplicationIcon>
    <Version>0.2.0</Version>
    <Authors>Κυριάκος Οικονομίδης / dwrean.net</Authors>
    <Product>dwrean Ελληνική Τηλεόραση</Product>
    <Description>Portable IPTV player για δωρεάν ελληνικά τηλεοπτικά κανάλια.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibVLCSharp.WinForms" Version="3.10.1" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.23.1" />
  </ItemGroup>

</Project>
